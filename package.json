{
  "name": "lingmo-novel-studio",
  "private": true,
  "version": "3.5.0",
  "description": "灵墨小说工坊 - AI 智能小说创作桌面应用",
  "author": "LingMo Studio <lingmo@example.com>",
  "main": "electron/main.js",
  "scripts": {
    "client:dev": "node scripts/ensure-deps.cjs --only-frontend && npx vite",
    "server:dev": "node scripts/ensure-deps.cjs --only-backend && node scripts/dev-server.js",
    "server:dev:watch": "npx nodemon --watch scripts/dev-server.js --exec \"node scripts/dev-server.js\"",
    "dev": "node scripts/ensure-deps.cjs && npx concurrently -n \"CLIENT,SERVER\" -c \"yellow,blue\" \"npx vite\" \"node scripts/dev-server.js\"",
    "dev:desktop": "node scripts/ensure-deps.cjs && node scripts/dev-server.js",
    "dev:electron": "node scripts/ensure-deps.cjs && npx concurrently -n \"CLIENT,SERVER,ELECTRON\" -c \"yellow,blue,green\" \"npx vite\" \"node scripts/dev-server.js\" \"node scripts/run-electron.cjs\"",
    "build": "node scripts/ensure-deps.cjs --only-frontend && npx vite build",
    "build:web": "node scripts/ensure-deps.cjs --only-frontend && npx vite build",
    "build:exe": "node scripts/ensure-deps.cjs && npx vite build && node scripts/verify-desktop.cjs && node scripts/run-electron-builder.cjs --win --x64",
    "build:electron": "node scripts/ensure-deps.cjs && npx vite build && node scripts/run-electron-builder.cjs --win --x64",
    "build:electron:all": "node scripts/ensure-deps.cjs && npx vite build && node scripts/run-electron-builder.cjs",
    "verify:desktop": "node scripts/verify-desktop.cjs",
    "preview": "npx vite preview",
    "check": "npx vue-tsc -b",
    "lint": "npx eslint . --ext .ts,.vue",
    "lint:fix": "npx eslint . --ext .ts,.vue --fix",
    "doctor": "node scripts/doctor.js",
    "clean": "node scripts/clean.js",
    "clean:deep": "node scripts/clean.js --deep",
    "download:electron": "node scripts/download-electron.cjs",
    "install:cn": "npm config set registry https://registry.npmmirror.com && npx cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm install --legacy-peer-deps",
    "install:all": "npx cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm install --legacy-peer-deps",
    "reinstall": "node scripts/clean.js --deep && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "axios": "1.6.8",
    "body-parser": "1.20.2",
    "cors": "2.8.5",
    "express": "4.18.3",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.11.25",
    "@types/node-schedule": "2.1.5",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "7.1.0",
    "@typescript-eslint/parser": "7.1.0",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/runtime-dom": "3.4.21",
    "@vue/tsconfig": "0.5.1",
    "autoprefixer": "10.4.18",
    "clsx": "2.1.1",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "28.2.5",
    "electron-builder": "24.13.3",
    "element-plus": "25.6.7",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.22.0",
    "lucide-vue-next": "0.344.0",
    "node-schedule": "2.1.1",
    "nodemon": "3.1.0",
    "pinia": "2.1.7",
    "postcss": "8.4.35",
    "sass": "1.71.1",
    "tailwind-merge": "2.2.1",
    "tailwindcss": "3.4.1",
    "tsx": "4.7.1",
    "typescript": "5.3.3",
    "vite": "5.1.4",
    "vue": "3.4.21",
    "vue-router": "4.3.0",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.lingmo.novel-studio",
    "productName": "灵墨小说工坊",
    "copyright": "Copyright © 2024 LingMo Studio",
    "electronVersion": "28.2.5",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "灵墨小说工坊"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/data",
        "to": "data"
      }
    ],
    "asar": false
  }
}
